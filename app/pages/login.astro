---
import Layout from '../layouts/Layout.astro';
import { Lock, User, ArrowRight } from 'lucide-react';
---

<Layout title="Secure Login Gateway" hideNav={true} hideFooter={true}>
  <div class="flex-1 flex items-center justify-center bg-gov-bg px-6 py-12 min-h-screen">
    <div class="w-full max-w-md bg-white border border-gov-border p-6 md:p-8 rounded-xxxl shadow-sm space-y-5">
      
      {/* Header */}
      <div class="text-center flex flex-col items-center gap-3">
        <img src="/karnataka_emblem.png" alt="Karnataka Coat of Arms" class="w-14 h-14 object-contain" width="56" height="56" />
        <div class="space-y-1">
          <span class="text-[9px] font-sans font-semibold tracking-wider text-slate-500 uppercase leading-none block">Government of Karnataka</span>
          <h2 class="text-base font-display font-semibold text-gov-navy tracking-tight leading-tight mt-1">KSP-ConAI Gateway</h2>
          <span class="text-[9px] uppercase tracking-wider text-slate-400 font-bold block">Secure Authentication Portal</span>
        </div>
      </div>

      {/* Login Form */}
      <form id="login-form" class="space-y-4">
        {/* Username */}
        <div class="space-y-1.5">
          <label for="username-input" class="text-[10px] font-bold text-slate-500 uppercase">Username / Email</label>
          <div class="relative">
            <User className="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
            <input
              type="text"
              id="username-input"
              required
              placeholder="officer.name@ksp.gov.in"
              class="w-full pl-10 pr-4 py-2 bg-slate-50 hover:bg-slate-100/50 border border-gov-border focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none rounded-xl text-xs text-gov-navy placeholder-slate-450 h-10 transition"
            />
          </div>
        </div>

        {/* Password */}
        <div class="space-y-1.5">
          <label for="password-input" class="text-[10px] font-bold text-slate-500 uppercase">Password</label>
          <div class="relative">
            <Lock className="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
            <input
              type="password"
              id="password-input"
              required
              placeholder="••••••••••••"
              class="w-full pl-10 pr-4 py-2 bg-slate-50 hover:bg-slate-100/50 border border-gov-border focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none rounded-xl text-xs text-gov-navy placeholder-slate-450 h-10 transition"
            />
          </div>
        </div>

        {/* Sign In Button */}
        <button
          type="submit"
          class="w-full py-2.5 bg-gov-navy hover:bg-slate-800 text-white font-bold rounded-xl text-xs focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none transition cursor-pointer flex items-center justify-center gap-1.5 shadow-sm"
        >
          Sign In <ArrowRight className="w-3.5 h-3.5" />
        </button>
      </form>

      {/* Divider */}
      <div class="flex items-center justify-between gap-3 text-[10px] text-slate-400 font-bold uppercase py-1">
        <hr class="w-full border-slate-200" />
        <span class="shrink-0">Or Sign In With</span>
        <hr class="w-full border-slate-200" />
      </div>

      {/* Social OAuth Buttons */}
      <div class="grid grid-cols-2 gap-3">
        {/* Google OAuth */}
        <button
          type="button"
          id="google-oauth-btn"
          class="flex items-center justify-center gap-2 p-2.5 border border-gov-border hover:bg-slate-50 rounded-xl text-xs font-bold text-gov-navy cursor-pointer focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none transition shadow-2xs"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
          </svg>
          Google
        </button>

        {/* Zoho OAuth */}
        <button
          type="button"
          id="zoho-oauth-btn"
          class="flex items-center justify-center gap-2 p-2.5 border border-gov-border hover:bg-slate-50 rounded-xl text-xs font-bold text-gov-navy cursor-pointer focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none transition shadow-2xs"
        >
          <div class="w-4 h-4 bg-amber-500 rounded flex items-center justify-center text-white font-black text-[10px] leading-none select-none">
            Z
          </div>
          Zoho
        </button>
      </div>

      {/* Toggle Sign Up Link */}
      <div class="text-center text-[11px] text-slate-400 pt-1">
        Don't have an account? <a href="/signup" class="text-gov-blue hover:underline font-bold focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none rounded-sm">Sign Up</a>
      </div>
    </div>
  </div>

  <script>
    import { DEMO_USERS, setSession, type UserRole } from '../lib/auth';

    // Hook up normal form submit (simulated auth check)
    const loginForm = document.getElementById('login-form');
    if (loginForm) {
      loginForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const usernameInput = document.getElementById('username-input') as HTMLInputElement;
        const passwordInput = document.getElementById('password-input') as HTMLInputElement;
        
        if (usernameInput && passwordInput) {
          const userVal = usernameInput.value.trim().toLowerCase();
          
          // Match inputs or default to investigator
          let roleMatch: UserRole = 'investigator';
          if (userVal.includes('admin') || userVal.includes('dayananda')) {
            roleMatch = 'admin';
          } else if (userVal.includes('analyst') || userVal.includes('praveen')) {
            roleMatch = 'analyst';
          } else if (userVal.includes('viewer') || userVal.includes('supervisor')) {
            roleMatch = 'viewer';
          }
          
          // Simulate login session setup
          const defaultSession = DEMO_USERS[roleMatch];
          setSession({
            ...defaultSession,
            username: userVal || defaultSession.username
          });
          window.location.href = '/dashboard';
        }
      });
    }

    // Hook up social logins clicks (simulated bypass)
    const googleBtn = document.getElementById('google-oauth-btn');
    const zohoBtn = document.getElementById('zoho-oauth-btn');
    [googleBtn, zohoBtn].forEach(btn => {
      if (btn) {
        btn.addEventListener('click', () => {
          setSession(DEMO_USERS.investigator);
          window.location.href = '/dashboard';
        });
      }
    });
  </script>
</Layout>
