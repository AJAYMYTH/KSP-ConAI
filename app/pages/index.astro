---
import Layout from '../layouts/Layout.astro';
import { 
  Shield, Bot, Network, Activity, FileText, Lock, Globe, ArrowRight, 
  HelpCircle, Cpu, Zap, CheckCircle2, ChevronRight, Terminal, UserCheck
} from 'lucide-react';
---

<Layout title="KSP-ConAI — Intelligent Crime Intelligence Platform" hideNav={true} hideFooter={true}>
  <!-- ================= 1. GOVERNMENT HEADER ================= -->
  <header class="sticky top-0 z-50 w-full bg-white border-b border-gov-border px-6 md:px-8 py-3.5 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <img src="/karnataka_emblem.png" alt="Karnataka Coat of Arms" class="w-10 h-10 object-contain" width="40" height="40" />
      <div class="flex flex-col text-left border-l border-gov-border pl-3">
        <span class="text-[9px] font-sans font-semibold tracking-wider text-slate-500 uppercase">
          <span class="lang-en">Government of Karnataka</span>
          <span class="lang-kn">ಕರ್ನಾಟಕ ಸರ್ಕಾರ</span>
        </span>
        <span class="text-[9px] font-sans font-semibold tracking-wider text-slate-500 uppercase leading-none">
          <span class="lang-en">Karnataka State Police</span>
          <span class="lang-kn">ಕರ್ನಾಟಕ ರಾಜ್ಯ ಪೊಲೀಸ್</span>
        </span>
        <span class="font-display font-semibold text-xs text-gov-navy mt-1 tracking-tight">KSP-ConAI</span>
      </div>
    </div>

    {/* Center Navigation Links */}
    <nav class="hidden lg:flex items-center gap-6 font-display font-medium text-xs text-slate-600">
      <a href="#about" class="hover:text-gov-blue focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none rounded-sm transition">
        <span class="lang-en">Home</span>
        <span class="lang-kn">ಮುಖಪುಟ</span>
      </a>
      <a href="#about" class="hover:text-gov-blue focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none rounded-sm transition">
        <span class="lang-en">About</span>
        <span class="lang-kn">ಬಗ್ಗೆ</span>
      </a>
      <a href="#capabilities" class="hover:text-gov-blue focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none rounded-sm transition">
        <span class="lang-en">Capabilities</span>
        <span class="lang-kn">ಸಾಮರ್ಥ್ಯಗಳು</span>
      </a>
      <a href="#workflow" class="hover:text-gov-blue focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none rounded-sm transition">
        <span class="lang-en">Workflow</span>
        <span class="lang-kn">ಕಾರ್ಯವಿಧಾನ</span>
      </a>
      <a href="#faq" class="hover:text-gov-blue focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none rounded-sm transition">
        <span class="lang-en">FAQ</span>
        <span class="lang-kn">ಪ್ರಶ್ನೆಗಳು</span>
      </a>
    </nav>

    {/* Right side controls */}
    <div class="flex items-center gap-4">
      {/* Language Switcher Button */}
      <button 
        id="lang-toggle"
        class="flex items-center gap-1 px-3 py-1.5 bg-gov-bg border border-gov-border rounded-full text-[10px] font-display font-medium text-slate-700 hover:bg-slate-100 focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none transition cursor-pointer select-none"
        aria-label="Toggle language between English and Kannada"
      >
        <Globe className="w-3.5 h-3.5 text-slate-400" />
        <span class="lang-en">English</span>
        <span class="lang-kn">ಕನ್ನಡ</span>
      </button>

      <a 
        href="/login" 
        class="px-5 py-2 bg-gov-navy text-white hover:bg-gov-blue rounded-full text-xs font-display font-medium focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none transition select-none shadow-sm"
      >
        <span class="lang-en">Login</span>
        <span class="lang-kn">ಲಾಗಿನ್</span>
      </a>
    </div>
  </header>

  <!-- Main scrollable layout using official governance page background -->
  <div class="bg-gov-bg min-h-screen text-gov-navy font-sans antialiased selection:bg-slate-200">
    
    <!-- ================= 2. HERO SECTION ================= -->
    <section class="max-w-7xl mx-auto px-6 md:px-8 py-16 md:py-24 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <span class="font-display font-semibold text-xs tracking-wider text-gov-red uppercase block">
          <span class="lang-en">Karnataka State Police — Official Release</span>
          <span class="lang-kn">ಕರ್ನಾಟಕ ರಾಜ್ಯ ಪೊಲೀಸ್ — ಅಧಿಕೃತ ಬಿಡುಗಡೆ</span>
        </span>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-display font-semibold text-gov-navy leading-[1.15] tracking-tight">
          <span class="lang-en">KSP-ConAI: <br/><span class="text-gov-blue">Intelligent Conversational Crime Intelligence Platform</span></span>
          <span class="lang-kn">KSP-ConAI: <br/><span class="text-gov-blue">ಅಪರಾಧ ಗುಪ್ತಚರ ಸಂಭಾಷಣಾ ವೇದಿಕೆ</span></span>
        </h1>
        <p class="text-xs md:text-sm text-slate-600 leading-relaxed max-w-xl">
          <span class="lang-en">An AI-powered investigation and crime analytics platform developed to assist investigators, analysts, supervisors, and policymakers in discovering criminal relationships, analyzing crime patterns, and generating evidence-backed investigative insights using natural language.</span>
          <span class="lang-kn">ಅಪರಾಧ ತನಿಖೆ ಮತ್ತು ವಿಶ್ಲೇಷಣೆಗಾಗಿ ಅಭಿವೃದ್ಧಿಪಡಿಸಲಾದ ಕೃತಕ ಬುದ್ಧಿಮತ್ತೆ ಆಧಾರಿತ ವೇದಿಕೆ. ಇದು ತನಿಖಾಧಿಕಾರಿಗಳಿಗೆ ಅಪರಾಧ ಜಾಲಗಳನ್ನು ಗುರುತಿಸಲು ಮತ್ತು ಸಂಶೋಧನಾ ಮಾಹಿತಿಗಳನ್ನು ಪಡೆಯಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ.</span>
        </p>
        
        <div class="flex flex-wrap gap-3.5 pt-2">
          <a href="/login" class="px-6 py-3 bg-gov-navy text-white hover:bg-gov-blue rounded-full text-xs font-display font-medium focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none transition shadow-sm select-none">
            <span class="lang-en">Launch Platform</span>
            <span class="lang-kn">ವೇದಿಕೆ ಪ್ರವೇಶಿಸಿ</span>
          </a>
          <a href="#capabilities" class="px-6 py-3 bg-white border border-gov-border text-slate-700 hover:bg-slate-50 rounded-full text-xs font-display font-medium focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none transition select-none">
            <span class="lang-en">Explore Features</span>
            <span class="lang-kn">ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಅನ್ವೇಷಿಸಿ</span>
          </a>
        </div>
      </div>

      {/* Right Side: High-Fidelity Intelligence Terminal Preview */}
      <div class="lg:col-span-5 bg-[#0b0f19] border border-slate-800 rounded-xxl p-5 shadow-xl relative overflow-hidden select-none">
        {/* Terminal Header Bar */}
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
          <div class="flex items-center gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full bg-gov-red"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-amber-500"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-emerald-500"></div>
          </div>
          <div class="flex items-center gap-1 px-2.5 py-0.5 bg-slate-900 border border-slate-800 rounded-md text-[8px] font-mono text-slate-400 uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping inline-block mr-1"></span>
            Secure Session : Active
          </div>
        </div>

        {/* Terminal Inner Workspace */}
        <div class="font-mono text-[10px] space-y-4 text-slate-300">
          <div class="flex items-center gap-2 text-slate-400">
            <span class="text-emerald-500">$</span>
            <span>sentinel-query --accused "Mahesh Kumar" --depth 2</span>
          </div>

          <div class="space-y-1.5 border-l-2 border-slate-800 pl-3">
            <div class="text-slate-400">> Fetching criminal registry... <span class="text-emerald-500">12 matches</span></div>
            <div class="text-slate-400">> Building relationship graph... <span class="text-emerald-500">Done</span></div>
            <div class="text-slate-400">> Identified high-risk nodes: <span class="text-gov-red font-bold">2 flagged</span></div>
          </div>

          {/* Relationship Network Mockup */}
          <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-4 flex flex-col items-center justify-center relative min-h-[140px] my-3">
            <div class="absolute inset-0 opacity-[0.03] bg-[radial-gradient(#1e3a8a_1px,transparent_1px)] [background-size:16px_16px]"></div>
            
            {/* Visual Nodes */}
            <div class="relative w-full h-24 flex items-center justify-center">
              {/* Central Node */}
              <div class="absolute w-8 h-8 rounded-full bg-gov-red/20 border-2 border-gov-red flex items-center justify-center z-15">
                <Shield className="w-4 h-4 text-gov-red" />
              </div>
              <div class="absolute text-[8px] text-gov-red font-bold -bottom-1">MAHESH K. (Accused)</div>

              {/* Node 2 */}
              <div class="absolute -top-3 -left-4 w-6 h-6 rounded-full bg-slate-900 border border-slate-700 flex items-center justify-center">
                <UserCheck className="w-3 h-3 text-slate-400" />
              </div>
              <div class="absolute text-[7px] text-slate-400 top-4 -left-9">Praveen G.</div>

              {/* Node 3 */}
              <div class="absolute -bottom-2 -right-6 w-6 h-6 rounded-full bg-slate-900 border border-slate-700 flex items-center justify-center">
                <UserCheck className="w-3 h-3 text-slate-400" />
              </div>
              <div class="absolute text-[7px] text-slate-400 bottom-5 -right-12">Suresh M.</div>

              {/* Connection Lines (CSS borders acting as lines) */}
              <svg class="absolute inset-0 w-full h-full text-slate-800 pointer-events-none opacity-40" xmlns="http://www.w3.org/2000/svg">
                <line x1="50%" y1="50%" x2="25%" y2="25%" stroke="currentColor" stroke-width="1" stroke-dasharray="2" />
                <line x1="50%" y1="50%" x2="70%" y2="70%" stroke="currentColor" stroke-width="1" />
              </svg>
            </div>
          </div>

          {/* Underbar Stats */}
          <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-800 text-[9px]">
            <div>
              <span class="text-slate-500 block uppercase">Confidence Index</span>
              <span class="font-bold text-emerald-400">94.8% (Grounded)</span>
            </div>
            <div>
              <span class="text-slate-500 block uppercase">Core Gateway</span>
              <span class="font-bold text-slate-400">QuickML / Zia Engine</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 3. STRATEGIC MISSION & COMPREHENSIVE STATS ================= -->
    <section id="about" class="border-t border-gov-border bg-white py-16">
      <div class="max-w-7xl mx-auto px-6 md:px-8 space-y-12">
        <div class="max-w-3xl mx-auto text-center space-y-4">
          <span class="text-[9px] font-display font-bold text-gov-red uppercase tracking-widest block">
            <span class="lang-en">Strategic Protocol</span>
            <span class="lang-kn">ಕಾರ್ಯತಂತ್ರದ ಶಿಷ್ಟಾಚಾರ</span>
          </span>
          <h2 class="text-2xl font-display font-semibold text-gov-navy leading-tight">
            <span class="lang-en">Empowering Law Enforcement via Responsible Intelligence</span>
            <span class="lang-kn">ಜವಾಬ್ದಾರಿಯುತ ತಂತ್ರಜ್ಞಾನದಿಂದ ಕಾನೂನು ಜಾರಿ ಸಬಲೀಕರಣ</span>
          </h2>
          <p class="text-xs md:text-sm text-slate-600 leading-relaxed italic max-w-2xl mx-auto">
            <span class="lang-en">"Providing explainable analytics, relation mapping, and natural language query capability to support state investigators, accelerate prosecution parameters, and ensure complete digital auditing compliance."</span>
            <span class="lang-kn">"ತನಿಖಾಧಿಕಾರಿಗಳಿಗೆ ಸಹಾಯ ಮಾಡಲು, ತನಿಖಾ ಪ್ರಕ್ರಿಯೆಗಳನ್ನು ವೇಗಗೊಳಿಸಲು ಮತ್ತು ಡಿಜಿಟಲ್ ಆಡಿಟಿಂಗ್ ಅನುಸರಣೆಯನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಲು ಸಂಬಂಧ ನಕ್ಷೆಗಳು ಮತ್ತು ಪ್ರಶ್ನೆ ಸಾಮರ್ಥ್ಯ ಒದಗಿಸುವುದು."</span>
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-4 max-w-5xl mx-auto text-center">
          {[
            { value: '45,000+', labelEn: 'FIR Case Files Ingested', labelKn: 'ದಾಖಲಿಸಲಾದ ಒಟ್ಟು ಎಫ್‌ಐಆರ್‌ಗಳು' },
            { value: '25,000+', labelEn: 'Criminal Nodes Linked', labelKn: 'ಸಂಪರ್ಕಿತ ಶಂಕಿತ ವ್ಯಕ್ತಿಗಳು' },
            { value: '100%', labelEn: 'Grounded Query Accountability', labelKn: 'ನಿಖರವಾದ ಪ್ರಶ್ನೆ ಹೊಣೆಗಾರಿಕೆ' },
            { value: '24/7', labelEn: 'Tactical On-demand Access', labelKn: 'ನಿರಂತರ ಲಭ್ಯತೆ' }
          ].map((stat) => (
            <div class="space-y-1.5 p-4 border border-gov-border bg-gov-bg/30 rounded-xl">
              <div class="text-xl md:text-2xl font-display font-bold text-gov-blue tabular-nums">{stat.value}</div>
              <div class="text-[9px] font-sans font-bold text-slate-500 uppercase tracking-wider leading-tight">
                <span class="lang-en">{stat.labelEn}</span>
                <span class="lang-kn">{stat.labelKn}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= 4. KEY CAPABILITIES (CONSOLIDATED BENTO GRID) ================= -->
    <section id="capabilities" class="border-t border-gov-border py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-6 md:px-8 space-y-12">
        <div class="text-center space-y-2 max-w-xl mx-auto">
          <span class="text-[9px] font-display font-bold text-gov-blue uppercase tracking-widest block">
            <span class="lang-en">System Capabilities</span>
            <span class="lang-kn">ವ್ಯವಸ್ಥೆಯ ಸಾಮರ್ಥ್ಯಗಳು</span>
          </span>
          <h2 class="text-xl md:text-2xl font-display font-semibold text-gov-navy">
            <span class="lang-en">Consolidated Analytical Workspace</span>
            <span class="lang-kn">ಕ್ರೋಢೀಕೃತ ವಿಶ್ಲೇಷಣಾತ್ಮಕ ಕಾರ್ಯಕ್ಷೇತ್ರ</span>
          </h2>
          <p class="text-xs text-slate-500 leading-relaxed">
            <span class="lang-en">Discover relations, search registers, and generate audit-grounded briefs from a single interface.</span>
            <span class="lang-kn">ಒಂದೇ ಇಂಟರ್ಫೇಸ್‌ನಿಂದ ಸಂಬಂಧಗಳನ್ನು ಪತ್ತೆ ಮಾಡಿ, ರೆಜಿಸ್ಟರ್‌ಗಳನ್ನು ಹುಡುಕಿ ಮತ್ತು ದೃಢೀಕೃತ ವರದಿಗಳನ್ನು ರಚಿಸಿ.</span>
          </p>
        </div>

        {/* Bento Grid Layout */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
          
          {/* Card 1: Conversational Assistant (Wide) */}
          <div class="md:col-span-2 bg-white border border-gov-border p-6 rounded-xxxl shadow-sm flex flex-col justify-between min-h-[220px]">
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-gov-blue">
                <Bot className="w-5 h-5" />
                <h3 class="text-xs font-display font-bold text-gov-navy uppercase tracking-wider">
                  <span class="lang-en">Conversational Crime Assistant</span>
                  <span class="lang-kn">ಅಪರಾಧ ಗುಪ್ತಚರ ಸಂಭಾಷಣಾ ಸಹಾಯಕ</span>
                </h3>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                <span class="lang-en">Query the police database in plain English or Kannada. Retrieve statistical breakdowns, offender registers, and active trends using Retrieval-Augmented Generation (RAG) backed by explicit database records.</span>
                <span class="lang-kn">ಪೊಲೀಸ್ ಡೇಟಾಬೇಸ್ ಅನ್ನು ಸರಳ ಇಂಗ್ಲಿಷ್ ಅಥವಾ ಕನ್ನಡದಲ್ಲಿ ಪ್ರಶ್ನಿಸಿ. ಅಧಿಕೃತ ಡೇಟಾಬೇಸ್ ದಾಖಲೆಗಳಿಂದ ಬೆಂಬಲಿತವಾಗಿರುವ ಅಂಕಿಅಂಶಗಳ ವಿವರಗಳನ್ನು, ಅಪರಾಧಿಗಳ ರಿಜಿಸ್ಟರ್‌ಗಳನ್ನು ಮತ್ತು ಪ್ರಚಲಿತ ಪ್ರವೃತ್ತಿಗಳನ್ನು ಪಡೆಯಿರಿ.</span>
              </p>
            </div>
            <div class="pt-4 border-t border-gov-border flex gap-4 text-[9px] text-slate-400 font-mono">
              <span>SQL LOG AUDITABLE</span>
              <span>•</span>
              <span>SSE STREAMING ENABLED</span>
            </div>
          </div>

          {/* Card 2: Relationship Networks (Narrow) */}
          <div class="bg-white border border-gov-border p-6 rounded-xxxl shadow-sm flex flex-col justify-between min-h-[220px]">
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-gov-red">
                <Network className="w-5 h-5" />
                <h3 class="text-xs font-display font-bold text-gov-navy uppercase tracking-wider">
                  <span class="lang-en">Association Mapping</span>
                  <span class="lang-kn">ಸಂಬಂಧ ನಕ್ಷೆಗಳ ಪತ್ತೆ</span>
                </h3>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                <span class="lang-en">Discover association pathways between co-accused entities. Inspect visual maps of recidivism connections across municipal police stations.</span>
                <span class="lang-kn">ಸಹ-ಆರೋಪಿಗಳ ನಡುವಿನ ಸಂಬಂಧದ ಕೊಂಡಿಗಳನ್ನು ಪತ್ತೆ ಹಚ್ಚಿ. ವಿವಿಧ ಪೊಲೀಸ್ ಠಾಣೆಗಳ ವ್ಯಾಪ್ತಿಯಲ್ಲಿ ಅಪರಾಧ ಮರುಕಳಿಸುವಿಕೆಯ ಸಂಪರ್ಕಗಳ ದೃಶ್ಯ ನಕ್ಷೆಗಳನ್ನು ವೀಕ್ಷಿಸಿ.</span>
              </p>
            </div>
            <div class="pt-4 border-t border-gov-border text-[9px] text-slate-400 font-mono">
              <span>SVG GRAPH RENDER</span>
            </div>
          </div>

          {/* Card 3: Crime Analytics (Narrow) */}
          <div class="bg-white border border-gov-border p-6 rounded-xxxl shadow-sm flex flex-col justify-between min-h-[220px]">
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-gov-blue">
                <Activity className="w-5 h-5" />
                <h3 class="text-xs font-display font-bold text-gov-navy uppercase tracking-wider">
                  <span class="lang-en">Spatio-Temporal Trends</span>
                  <span class="lang-kn">ಭೂ-ಸ್ಥಳೀಯ ಪ್ರವೃತ್ತಿಗಳು</span>
                </h3>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                <span class="lang-en">Investigate active hot-spots and track regional distributions. Filter by crime head categories, registration volumes, and disposal rates.</span>
                <span class="lang-kn">ಸಕ್ರಿಯ ಹಾಟ್‌ಸ್ಪಾಟ್‌ಗಳನ್ನು ತನಿಖೆ ಮಾಡಿ ಮತ್ತು ಪ್ರಾದೇಶಿಕ ವಿತರಣೆಯನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಿ. ಅಪರಾಧ ವರ್ಗಗಳು ಮತ್ತು ಪ್ರಕರಣಗಳ ಇತ್ಯರ್ಥ ದರಗಳ ಮೂಲಕ ಫಿಲ್ಟರ್ ಮಾಡಿ.</span>
              </p>
            </div>
            <div class="pt-4 border-t border-gov-border text-[9px] text-slate-400 font-mono">
              <span>REAL-TIME STATISTICS</span>
            </div>
          </div>

          {/* Card 4: Document Intelligence (Wide) */}
          <div class="md:col-span-2 bg-white border border-gov-border p-6 rounded-xxxl shadow-sm flex flex-col justify-between min-h-[220px]">
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-gov-navy">
