---
import Layout from '../layouts/Layout.astro';
import { 
  Shield, Bot, Network, Activity, FileText, Lock, Globe, ArrowRight, 
  HelpCircle, Cpu, Zap, CheckCircle2, ChevronRight, Terminal, UserCheck
} from 'lucide-react';
---

<Layout title="KSP-ConAI — Intelligent Crime Intelligence Platform" hideNav={true} hideFooter={true}>
  <!-- ================= 1. GOVERNMENT HEADER ================= -->
  <header class="sticky top-0 z-50 w-full bg-white border-b border-gov-border px-6 md:px-8 py-3.5 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <img src="/karnataka_emblem.png" alt="Karnataka Coat of Arms" class="w-10 h-10 object-contain" width="40" height="40" />
      <div class="flex flex-col text-left border-l border-gov-border pl-3">
        <span class="text-[9px] font-sans font-semibold tracking-wider text-slate-500 uppercase">Government of Karnataka</span>
        <span class="text-[9px] font-sans font-semibold tracking-wider text-slate-500 uppercase leading-none">Karnataka State Police</span>
        <span class="font-display font-semibold text-xs text-gov-navy mt-1 tracking-tight">KSP-ConAI</span>
      </div>
    </div>

    {/* Center Navigation Links */}
    <nav class="hidden lg:flex items-center gap-6 font-display font-medium text-xs text-slate-600">
      <a href="#about" class="hover:text-gov-blue focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none rounded-sm transition">Home</a>
      <a href="#about" class="hover:text-gov-blue focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none rounded-sm transition">About</a>
      <a href="#capabilities" class="hover:text-gov-blue focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none rounded-sm transition">Capabilities</a>
      <a href="#workflow" class="hover:text-gov-blue focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none rounded-sm transition">Workflow</a>
      <a href="#faq" class="hover:text-gov-blue focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none rounded-sm transition">FAQ</a>
    </nav>

    {/* Right side controls */}
    <div class="flex items-center gap-4">
      {/* Language Switcher Mock */}
      <button 
        id="lang-toggle"
        class="flex items-center gap-1 px-3 py-1.5 bg-gov-bg border border-gov-border rounded-full text-[10px] font-display font-medium text-slate-700 hover:bg-slate-100 focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none transition cursor-pointer select-none"
        aria-label="Toggle language between English and Kannada"
      >
        <Globe className="w-3.5 h-3.5 text-slate-400" />
        <span id="lang-label">English</span>
      </button>

      <a 
        href="/login" 
        class="px-5 py-2 bg-gov-navy text-white hover:bg-gov-blue rounded-full text-xs font-display font-medium focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none transition select-none shadow-sm"
      >
        Login
      </a>
    </div>
  </header>

  <!-- Main scrollable layout using official governance page background -->
  <div class="bg-gov-bg min-h-screen text-gov-navy font-sans antialiased selection:bg-slate-200">
    
    <!-- ================= 2. HERO SECTION ================= -->
    <section class="max-w-7xl mx-auto px-6 md:px-8 py-16 md:py-24 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <span class="font-display font-semibold text-xs tracking-wider text-gov-red uppercase block">
          Karnataka State Police — Official Release
        </span>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-display font-semibold text-gov-navy leading-[1.15] tracking-tight">
          KSP-ConAI: <br/>
          <span class="text-gov-blue">Intelligent Conversational Crime Intelligence Platform</span>
        </h1>
        <p class="text-xs md:text-sm text-slate-600 leading-relaxed max-w-xl">
          An AI-powered investigation and crime analytics platform developed to assist investigators, analysts, supervisors, and policymakers in discovering criminal relationships, analyzing crime patterns, and generating evidence-backed investigative insights using natural language.
        </p>
        
        <div class="flex flex-wrap gap-3.5 pt-2">
          <a href="/login" class="px-6 py-3 bg-gov-navy text-white hover:bg-gov-blue rounded-full text-xs font-display font-medium focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none transition shadow-sm select-none">
            Launch Platform
          </a>
          <a href="#capabilities" class="px-6 py-3 bg-white border border-gov-border text-slate-700 hover:bg-slate-50 rounded-full text-xs font-display font-medium focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none transition select-none">
            Explore Features
          </a>
        </div>
      </div>

      {/* Right Side: High-Fidelity Intelligence Terminal Preview */}
      <div class="lg:col-span-5 bg-[#0b0f19] border border-slate-800 rounded-xxl p-5 shadow-xl relative overflow-hidden select-none">
        {/* Terminal Header Bar */}
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
          <div class="flex items-center gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full bg-gov-red"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-amber-500"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-emerald-500"></div>
          </div>
          <div class="flex items-center gap-1 px-2.5 py-0.5 bg-slate-900 border border-slate-800 rounded-md text-[8px] font-mono text-slate-400 uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping inline-block mr-1"></span>
            Secure Session : Active
          </div>
        </div>

        {/* Terminal Inner Workspace */}
        <div class="font-mono text-[10px] space-y-4 text-slate-300">
          <div class="flex items-center gap-2 text-slate-400">
            <span class="text-emerald-500">$</span>
            <span>sentinel-query --accused "Mahesh Kumar" --depth 2</span>
          </div>

          <div class="space-y-1.5 border-l-2 border-slate-800 pl-3">
            <div class="text-slate-400">> Fetching criminal registry... <span class="text-emerald-500">12 matches</span></div>
            <div class="text-slate-400">> Building relationship graph... <span class="text-emerald-500">Done</span></div>
            <div class="text-slate-400">> Identified high-risk nodes: <span class="text-gov-red font-bold">2 flagged</span></div>
          </div>

          {/* Relationship Network Mockup */}
          <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-4 flex flex-col items-center justify-center relative min-h-[140px] my-3">
            <div class="absolute inset-0 opacity-[0.03] bg-[radial-gradient(#1e3a8a_1px,transparent_1px)] [background-size:16px_16px]"></div>
            
            {/* Visual Nodes */}
            <div class="relative w-full h-24 flex items-center justify-center">
              {/* Central Node */}
              <div class="absolute w-8 h-8 rounded-full bg-gov-red/20 border-2 border-gov-red flex items-center justify-center z-15">
                <Shield className="w-4 h-4 text-gov-red" />
              </div>
              <div class="absolute text-[8px] text-gov-red font-bold -bottom-1">MAHESH K. (Accused)</div>

              {/* Node 2 */}
              <div class="absolute -top-3 -left-4 w-6 h-6 rounded-full bg-slate-900 border border-slate-700 flex items-center justify-center">
                <UserCheck className="w-3 h-3 text-slate-400" />
              </div>
              <div class="absolute text-[7px] text-slate-400 top-4 -left-9">Praveen G.</div>

              {/* Node 3 */}
              <div class="absolute -bottom-2 -right-6 w-6 h-6 rounded-full bg-slate-900 border border-slate-700 flex items-center justify-center">
                <UserCheck className="w-3 h-3 text-slate-400" />
              </div>
              <div class="absolute text-[7px] text-slate-400 bottom-5 -right-12">Suresh M.</div>

              {/* Connection Lines (CSS borders acting as lines) */}
              <svg class="absolute inset-0 w-full h-full text-slate-800 pointer-events-none opacity-40" xmlns="http://www.w3.org/2000/svg">
                <line x1="50%" y1="50%" x2="25%" y2="25%" stroke="currentColor" stroke-width="1" stroke-dasharray="2" />
                <line x1="50%" y1="50%" x2="70%" y2="70%" stroke="currentColor" stroke-width="1" />
              </svg>
            </div>
          </div>

          {/* Underbar Stats */}
          <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-800 text-[9px]">
            <div>
              <span class="text-slate-500 block uppercase">Confidence Index</span>
              <span class="font-bold text-emerald-400">94.8% (Grounded)</span>
            </div>
            <div>
              <span class="text-slate-500 block uppercase">Core Gateway</span>
              <span class="font-bold text-slate-400">QuickML / Zia Engine</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 3. STRATEGIC MISSION & COMPREHENSIVE STATS ================= -->
    <section id="about" class="border-t border-gov-border bg-white py-16">
      <div class="max-w-7xl mx-auto px-6 md:px-8 space-y-12">
        <div class="max-w-3xl mx-auto text-center space-y-4">
          <span class="text-[9px] font-display font-bold text-gov-red uppercase tracking-widest block">Strategic Protocol</span>
          <h2 class="text-2xl font-display font-semibold text-gov-navy leading-tight">Empowering Law Enforcement via Responsible Intelligence</h2>
          <p class="text-xs md:text-sm text-slate-600 leading-relaxed italic max-w-2xl mx-auto">
            "Providing explainable analytics, relation mapping, and natural language query capability to support state investigators, accelerate prosecution parameters, and ensure complete digital auditing compliance."
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-4 max-w-5xl mx-auto text-center">
          {[
            { value: '45,000+', label: 'FIR Case Files Ingested' },
            { value: '25,000+', label: 'Criminal Nodes Linked' },
            { value: '100%', label: 'Grounded Query Accountability' },
            { value: '24/7', label: 'Tactical On-demand Access' }
          ].map((stat) => (
            <div class="space-y-1.5 p-4 border border-gov-border bg-gov-bg/30 rounded-xl">
              <div class="text-xl md:text-2xl font-display font-bold text-gov-blue tabular-nums">{stat.value}</div>
              <div class="text-[9px] font-sans font-bold text-slate-500 uppercase tracking-wider leading-tight">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= 4. KEY CAPABILITIES (CONSOLIDATED BENTO GRID) ================= -->
    <section id="capabilities" class="border-t border-gov-border py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-6 md:px-8 space-y-12">
        <div class="text-center space-y-2 max-w-xl mx-auto">
          <span class="text-[9px] font-display font-bold text-gov-blue uppercase tracking-widest block">System Capabilities</span>
          <h2 class="text-xl md:text-2xl font-display font-semibold text-gov-navy">Consolidated Analytical Workspace</h2>
          <p class="text-xs text-slate-500 leading-relaxed">Discover relations, search registers, and generate audit-grounded briefs from a single interface.</p>
        </div>

        {/* Bento Grid Layout */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
          
          {/* Card 1: Conversational Assistant (Wide) */}
          <div class="md:col-span-2 bg-white border border-gov-border p-6 rounded-xxxl shadow-sm flex flex-col justify-between min-h-[220px]">
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-gov-blue">
                <Bot className="w-5 h-5" />
                <h3 class="text-xs font-display font-bold text-gov-navy uppercase tracking-wider">Conversational Crime Assistant</h3>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                Query the police database in plain English or Kannada. Retrieve statistical breakdowns, offender registers, and active trends using Retrieval-Augmented Generation (RAG) backed by explicit database records.
              </p>
            </div>
            <div class="pt-4 border-t border-gov-border flex gap-4 text-[9px] text-slate-400 font-mono">
              <span>SQL LOG AUDITABLE</span>
              <span>•</span>
              <span>SSE STREAMING ENABLED</span>
            </div>
          </div>

          {/* Card 2: Relationship Networks (Narrow) */}
          <div class="bg-white border border-gov-border p-6 rounded-xxxl shadow-sm flex flex-col justify-between min-h-[220px]">
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-gov-red">
                <Network className="w-5 h-5" />
                <h3 class="text-xs font-display font-bold text-gov-navy uppercase tracking-wider">Association Mapping</h3>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                Discover association pathways between co-accused entities. Inspect visual maps of recidivism connections across municipal police stations.
              </p>
            </div>
            <div class="pt-4 border-t border-gov-border text-[9px] text-slate-400 font-mono">
              <span>SVG GRAPH RENDER</span>
            </div>
          </div>

          {/* Card 3: Crime Analytics (Narrow) */}
          <div class="bg-white border border-gov-border p-6 rounded-xxxl shadow-sm flex flex-col justify-between min-h-[220px]">
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-gov-blue">
                <Activity className="w-5 h-5" />
                <h3 class="text-xs font-display font-bold text-gov-navy uppercase tracking-wider">Spatio-Temporal Trends</h3>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                Investigate active hot-spots and track regional distributions. Filter by crime head categories, registration volumes, and disposal rates.
              </p>
            </div>
            <div class="pt-4 border-t border-gov-border text-[9px] text-slate-400 font-mono">
              <span>REAL-TIME STATISTICS</span>
            </div>
          </div>

          {/* Card 4: Document Intelligence (Wide) */}
          <div class="md:col-span-2 bg-white border border-gov-border p-6 rounded-xxxl shadow-sm flex flex-col justify-between min-h-[220px]">
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-gov-navy">
                <FileText className="w-5 h-5" />
                <h3 class="text-xs font-display font-bold text-gov-navy uppercase tracking-wider">Explainable Evidence Briefs</h3>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                Compile investigation briefs instantly. KSP-ConAI parses raw timelines, registers missing milestones, and exports formatted PDF outputs using Catalyst SmartBrowz functions.
              </p>
            </div>
            <div class="pt-4 border-t border-gov-border flex gap-4 text-[9px] text-slate-400 font-mono">
              <span>PDF EXPORT ENABLED</span>
              <span>•</span>
              <span>TIMELINE VALIDATORS</span>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ================= 5. PROCEDURAL TIMELINE WORKFLOW ================= -->
    <section id="workflow" class="border-t border-gov-border bg-white py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-6 md:px-8 space-y-12">
        <div class="text-center space-y-2 max-w-xl mx-auto">
          <span class="text-[9px] font-display font-bold text-gov-red uppercase tracking-widest block">Pipeline Execution</span>
          <h2 class="text-xl md:text-2xl font-display font-semibold text-gov-navy">Grounded Investigation Timeline</h2>
          <p class="text-xs text-slate-500 leading-relaxed">The secure processing pipeline from FIR ingestion to actionable supervisor analytics.</p>
        </div>

        {/* Chronological horizontal timeline */}
        <div class="max-w-5xl mx-auto pt-6">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative">
            {/* Horizontal Line background for desktop */}
            <div class="hidden md:block absolute top-6 left-1/8 right-1/8 h-0.5 bg-slate-200 z-0"></div>

            {[
              { title: 'Ingest Records', desc: 'Securely sync daily FIR records to the Zoho Catalyst relational Data Store.' },
              { title: 'Vector & Indexing', desc: 'Zia Services semantic engine indexes names, offenses, and crime parameters.' },
              { title: 'Graph Computation', desc: 'Analyze relationship links to identify offender associations.' },
              { title: 'Resolve Insights', desc: 'Generate grounded summaries, execute audit logging, and export briefs.' }
            ].map((step, idx) => (
              <div class="relative flex flex-col items-center text-center space-y-3 z-10">
                <div class="w-12 h-12 rounded-full bg-gov-bg border-2 border-gov-blue text-gov-blue font-display font-bold text-sm flex items-center justify-center shadow-sm">
                  {idx + 1}
                </div>
                <h3 class="text-xs font-display font-bold text-gov-navy uppercase tracking-wider">{step.title}</h3>
                <p class="text-[11px] text-slate-500 leading-relaxed max-w-[200px]">{step.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 6. SECURITY, AUDIT & COMPLIANCE ================= -->
    <section class="border-t border-gov-border py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-6 md:px-8 space-y-12">
        <div class="text-center space-y-2 max-w-xl mx-auto">
          <span class="text-[9px] font-display font-bold text-gov-blue uppercase tracking-widest block">System Integrity</span>
          <h2 class="text-xl md:text-2xl font-display font-semibold text-gov-navy">Security & Regulatory Compliance</h2>
          <p class="text-xs text-slate-500 leading-relaxed">KSP-ConAI ensures strict operational boundaries aligned with state governance standards.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
          {[
            { title: 'Role-Based Authorization', desc: 'Restricted dashboard access. Investigators edit cases, analysts view metrics, and supervisors authorize records.' },
            { title: 'Secure Session Logs', desc: 'Every SQL query generated by the AI model is logged alongside user identity metadata.' },
            { title: 'Network Encryption', desc: 'All data operations leverage encrypted transport tunnels with state server standards.' },
            { title: 'Data Grounding Validation', desc: 'Zero hallucination architecture ensures queries fallback immediately if database links are missing.' },
            { title: 'Confidentiality Audits', desc: 'Compliant with national guidelines governing sensitive public information storage.' },
            { title: 'Bilingual Interface', desc: 'Bilingual system architecture natively rendering reports in English and Kannada.' }
          ].map((item) => (
            <div class="bg-white border border-gov-border p-5 rounded-xl space-y-2.5">
              <div class="flex items-center gap-2 text-gov-red">
                <Lock className="w-4 h-4" />
                <h3 class="text-xs font-display font-bold text-gov-navy uppercase tracking-wider">{item.title}</h3>
              </div>
              <p class="text-xs text-slate-500 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= 7. FAQ SECTION ================= -->
    <section id="faq" class="border-t border-gov-border bg-white py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-6 space-y-10">
        <div class="text-center space-y-2">
          <span class="text-[9px] font-display font-bold text-gov-blue uppercase tracking-widest block">Onboarding Support</span>
          <h2 class="text-xl md:text-2xl font-display font-semibold text-gov-navy">Frequently Asked Questions</h2>
        </div>

        <div class="space-y-4">
          {[
            { q: 'What is KSP-ConAI?', a: 'KSP-ConAI is a conversational crime intelligence and analytics platform developed for the Karnataka State Police to assist in case analysis.' },
            { q: 'Who can access the portal?', a: 'Authorized law enforcement officers, investigators, supervisors, and policymakers with approved Catalyst credentials.' },
            { q: 'How are AI answers verified?', a: 'KSP-ConAI renders active SQL logs alongside every summary, allowing investigators to audit the database records retrieved.' },
            { q: 'Is there a bilingual toggle?', a: 'Yes. Toggle language switchers natively render dashboard templates, search controls, and generated reports in English and Kannada.' }
          ].map((item) => (
            <details class="group bg-white border border-gov-border rounded-xl overflow-hidden transition">
              <summary class="px-5 py-4 text-xs font-display font-semibold text-gov-navy flex items-center justify-between cursor-pointer select-none">
                <span>{item.q}</span>
                <span class="text-slate-400 group-open:rotate-180 transition">▼</span>
              </summary>
              <div class="px-5 pb-4 border-t border-gov-border pt-3 text-xs text-slate-500 leading-relaxed bg-gov-bg/30">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= 8. CALL TO ACTION ================= -->
    <section class="border-t border-gov-border py-16 bg-gov-bg/50">
      <div class="max-w-4xl mx-auto px-6 text-center space-y-6">
        <span class="text-[9px] font-display font-bold text-gov-red uppercase tracking-widest block">Access Authorization</span>
        <h2 class="text-xl md:text-2xl font-display font-semibold text-gov-navy leading-tight">Ready to begin an investigation?</h2>
        <p class="text-xs text-slate-500 leading-relaxed max-w-md mx-auto">
          Access the platform to explore AI-assisted crime intelligence, case summary generation, and analytical capabilities.
        </p>
        <a 
          href="/login" 
          class="inline-block px-7 py-3.5 bg-gov-navy text-white hover:bg-gov-blue rounded-full text-xs font-display font-semibold focus-visible:ring-2 focus-visible:ring-gov-blue focus-visible:outline-none transition shadow-sm select-none"
        >
          Launch Dashboard
        </a>
      </div>
    </section>

    <!-- ================= 9. GOVERNMENT THEMED FOOTER ================= -->
    <footer class="bg-gov-navy text-slate-400 border-t border-slate-800 px-6 md:px-8 py-12 text-[10px] space-y-6">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="flex items-center gap-3">
          <img src="/karnataka_emblem.png" alt="Government Seal" class="w-9 h-9 object-contain" width="36" height="36" />
          <div class="flex flex-col text-left">
            <span class="font-bold text-slate-200 leading-tight">Government of Karnataka</span>
            <span class="text-slate-450 leading-none mt-0.5">Karnataka State Police</span>
          </div>
        </div>
        
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 text-[10px]">
          <a href="#" class="hover:text-white focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none rounded-sm transition">About</a>
          <span>•</span>
          <a href="#" class="hover:text-white focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none rounded-sm transition">Privacy Policy</a>
          <span>•</span>
          <a href="#" class="hover:text-white focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none rounded-sm transition">Terms of Service</a>
          <span>•</span>
          <a href="#" class="hover:text-white focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none rounded-sm transition">Accessibility</a>
          <span>•</span>
          <a href="#" class="hover:text-white focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none rounded-sm transition">Contact Support</a>
        </div>

        <div class="text-center md:text-right text-slate-500">
          <span>KSP-ConAI Portal (v1.1)</span>
        </div>
      </div>
      
      <div class="max-w-7xl mx-auto border-t border-slate-800 pt-6 text-center text-[9px] text-slate-550 leading-relaxed">
        © 2026 Government of Karnataka. All Rights Reserved. Confidential law-enforcement tool. Access and actions are governed under official information security guidelines.
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Simple bilingual toggle simulator
  const toggleBtn = document.getElementById('lang-toggle');
  const label = document.getElementById('lang-label');
  
  if (toggleBtn && label) {
    toggleBtn.addEventListener('click', () => {
      const current = label.innerText;
      if (current === 'English') {
        label.innerText = 'ಕನ್ನಡ (Kannada)';
      } else {
        label.innerText = 'English';
      }
    });
  }
</script>
