---
import Layout from '../layouts/Layout.astro';
import SearchInterface from '../components/search/SearchInterface.tsx';
import { PermissionGuard } from '../components/auth/PermissionGuard.tsx';
import { PERMISSIONS } from '../lib/auth';
---

<Layout title="FIR Search Database">
  <PermissionGuard permission={PERMISSIONS.SEARCH_FIRS} client:load>
    <SearchInterface client:load />
  </PermissionGuard>
</Layout>
