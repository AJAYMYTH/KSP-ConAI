---
import Layout from '../layouts/Layout.astro';
import DashboardGrid from '../components/dashboard/DashboardGrid.tsx';
import { PermissionGuard } from '../components/auth/PermissionGuard.tsx';
import { PERMISSIONS } from '../lib/auth';
---

<Layout title="Dashboard">
  <PermissionGuard permission={PERMISSIONS.VIEW_DASHBOARD} client:load>
    <DashboardGrid client:load />
  </PermissionGuard>
</Layout>
