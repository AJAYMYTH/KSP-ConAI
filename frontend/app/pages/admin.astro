---
import Layout from "../layouts/Layout.astro";
import AdminConsole from "../components/admin/AdminConsole.tsx";
import { PermissionGuard } from "../components/auth/PermissionGuard.tsx";
import { PERMISSIONS } from "../lib/auth.ts";
---

<Layout title="Admin Console">
  <PermissionGuard
    permission={PERMISSIONS.ACCESS_ADMIN_TOOLS}
    client:only="react"
  >
    <AdminConsole client:only="react" />
  </PermissionGuard>
</Layout>
