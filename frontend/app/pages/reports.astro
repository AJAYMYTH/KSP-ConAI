---
import Layout from "../layouts/Layout.astro";
import ReportsManager from "../components/reports/ReportsManager.tsx";
import { PermissionGuard } from "../components/auth/PermissionGuard.tsx";
import { PERMISSIONS } from "../lib/auth.ts";
---

<Layout title="Intelligence Reports History">
  <PermissionGuard
    permission={PERMISSIONS.GENERATE_REPORTS}
    client:only="react"
  >
    <ReportsManager client:only="react" />
  </PermissionGuard>
</Layout>
